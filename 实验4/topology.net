# Own topology. Student ID （已隐去；地址参数161）: 926 % 255 = 161.
autostart = False

[localhost]
    port = 7204
    udp = 14000
    workingdir = ./working

    [[router SW1]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        confreg = 0x2142
        mmap = False
        console = 3400
        exec_area = 64
        slot1 = NM-16ESW
        f1/1 = SW2 f1/1
        f1/2 = R1 f1/0
        f1/11 = PC20 f0/0
        f1/12 = PC30 f0/0

    [[router SW2]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
