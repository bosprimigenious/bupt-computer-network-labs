# Own topology. Student ID （已隐去；地址参数161）: 926 % 255 = 161.
autostart = False

[localhost]
    port = 7203
    udp = 13000
    workingdir = ./working

    [[router R1]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        confreg = 0x2142
        mmap = False
        console = 3300
        exec_area = 64
        slot0 = NM-1FE-TX
        slot1 = NM-1FE-TX
        slot2 = NM-1FE-TX
        f0/0 = PC1 f0/0
        f1/0 = R2 f0/0
        f2/0 = R3 f0/0

    [[router R2]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        confreg = 0x2142
        mmap = False
        console = 3301
        exec_area = 64
        slot0 = NM-1FE-TX
        slot1 = NM-1FE-TX
        f1/0 = R4 f1/0

    [[router R3]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        confreg = 0x2142
        mmap = False
        console = 3302
        exec_area = 64
        slot0 = NM-1FE-TX
        slot1 = NM-1FE-TX
        f1/0 = R4 f2/0

    [[router R4]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        confreg = 0x2142
        mmap = False
        console = 3303
        exec_area = 64
        slot0 = NM-1FE-TX
        slot1 = NM-1FE-TX
        slot2 = NM-1FE-TX
        f0/0 = PC2 f0/0

    [[router PC1]]
        model = 2621
        image = ../_环境/ios/unzip-c2600-i-mz.121-3.T.bin
        ram = 20
        confreg = 0x2142
        mmap = False
        console = 3304

    [[router PC2]]
        model = 2621
        image = ../_环境/ios/unzip-c2600-i-mz.121-3.T.bin
        ram = 20
        confreg = 0x2142
        mmap = False
        console = 3305
