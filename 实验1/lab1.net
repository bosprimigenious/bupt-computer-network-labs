# Launch from the directory containing this file.
# Edit image paths for your actual local IOS images before launch.
autostart = False

[localhost]
    port = 7200
    udp = 10000
    workingdir = ./working

    [[router SW1]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        slot1 = NM-16ESW
        confreg = 0x2142
        exec_area = 64
        mmap = False
        console = 3004
        f1/11 = PC1 f0/0
        f1/12 = PC2 f0/0
        f1/1 = SW2 f1/2
        f1/2 = SW2 f1/1

    [[router SW2]]
        model = 3640
        image = ../_环境/ios/unzip-c3640-js-mz.124-10.bin
        ram = 128
        slot1 = NM-16ESW
        confreg = 0x2142
        exec_area = 64
        mmap = False
        console = 3005
        f1/11 = PC3 f0/0

    [[router PC1]]
        model = 2621
        image = ../_环境/ios/unzip-c2600-i-mz.121-3.T.bin
        ram = 20
        mmap = False
        confreg = 0x2142
        console = 3006

    [[router PC2]]
        model = 2621
        image = ../_环境/ios/unzip-c2600-i-mz.121-3.T.bin
        ram = 20
        mmap = False
        confreg = 0x2142
        console = 3007

    [[router PC3]]
        model = 2621
        image = ../_环境/ios/unzip-c2600-i-mz.121-3.T.bin
        ram = 20
        mmap = False
        confreg = 0x2142
        console = 3008
