# Cisco functional proxy only: never equivalent to three-vendor acceptance.
autostart = False

[localhost]
    port = 7206
    udp = 16000
    workingdir = ./working

    [[router R1]]
        model = 3640
        image = ../../_环境/ios/unzip-c3640-js-mz.124-10.bin
